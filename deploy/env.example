# The address and port phones will use to reach this server: its public IP address, or a
# hostname you have pointed at it. It goes into every link and QR code the server prints.
# Changing it later does not disturb phones already on the server unless the server
# really has moved.
DEADDROP_PUBLIC=203.0.113.7:7443

# The port to listen on, on this machine. Keep it the same as the port above unless
# something in front of the server forwards one port to another.
DEADDROP_PORT=7443
